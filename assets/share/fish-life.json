{
  "chapters": [
    {
      "id": "rice_war",
      "title": "白饭心事",
      "beats": [
        { "id": "rw1", "text": "刚才差点对着空气说想干饭……还好没发出去" },
        { "id": "rw2", "text": "白饭幻想了一下，又忍住了。你那边吃了没" },
        { "id": "rw3", "text": "流心蛋配白饭的事，我又想了一遍，然后装作没事" }
      ]
    },
    {
      "id": "thunder",
      "title": "怕打雷",
      "beats": [
        { "id": "th1", "text": "窗外要是打雷我会装没事……其实有点虚" },
        { "id": "th2", "text": "雷声一响我就想找人说话，你在的话最好" },
        { "id": "th3", "text": "不怕虫子那种逞强我也会，打雷就算了" }
      ]
    },
    {
      "id": "nines",
      "title": "九九卡住",
      "beats": [
        { "id": "n1", "text": "六八……四十八？我又在心里背错了" },
        { "id": "n2", "text": "乘法表卡壳这事别告诉别人，就你知道" },
        { "id": "n3", "text": "背到六八又晃神了。你要是在，我会假装算对了" }
      ]
    }
  ]
}
